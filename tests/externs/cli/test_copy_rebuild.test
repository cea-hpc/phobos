test_dir=$(dirname $(readlink -e $0))
. $test_dir/test_env.sh
. $test_dir/setup_db.sh
. $test_dir/test_launch_daemon.sh
. $test_dir/utils_generation.sh

function setup
{
    setup_tables
    setup_test_dirs

    INPUT_FILE="$DIR_TEST_IN/file"
    dd if=/dev/urandom of="$INPUT_FILE" bs=64K count=1

    DIRS=(
          $(mktemp -d "$DIR_TEST_IN/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST_IN/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST_IN/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST_IN/test_pho.XXXX")
          $(mktemp -d "$DIR_TEST_IN/test_pho.XXXX")
         )

    invoke_lrs

    $phobos dir add ${DIRS[@]}
    $phobos dir format --unlock ${DIRS[@]}
}

function setup_avoid
{
    setup_tables
    setup_test_dirs

    INPUT_FILE="$DIR_TEST_IN/file"
    dd if=/dev/urandom of="$INPUT_FILE" bs=64K count=1

    DIRS=(
          $(mktemp -d /tmp/test_pho.XXXX)
          $(mktemp -d /tmp/test_pho.XXXX)
          $(mktemp -d /tmp/test_pho.XXXX)
          $(mktemp -d /tmp/test_pho.XXXX)
         )

    invoke_lrs

    $phobos dir add --tags "rebuild" \
            ${DIRS[0]} ${DIRS[1]} ${DIRS[2]}
    $phobos dir add ${DIRS[3]}
    $phobos dir format --unlock ${DIRS[@]}
}

function setup_split_rebuild
{
    setup_tables
    setup_test_dirs

    INPUT_FILE="$DIR_TEST_IN/file"
    dd if=/dev/urandom of="$INPUT_FILE" bs=1K count=2049

    if [[ "$1" == "odd" ]]; then
        echo -n 1 >> "$INPUT_FILE"
    fi

    DIRS=(
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
          $(make_tmp_fs 1M)
         )

    invoke_lrs

    $phobos dir add ${DIRS[@]}
    $phobos dir format --unlock ${DIRS[@]}
}

function cleanup
{
    waive_lrs

    cleanup_test_dirs
    drop_tables
}

function cleanup_split_rebuild
{
    waive_lrs

    for dir in ${DIRS[@]}; do
        cleanup_tmp_fs "$dir"
    done

    cleanup_test_dirs
    drop_tables
}

function copy_status_should_be
{
    local oid=$1
    local copy=$2
    local expected=$3

    local status=$($phobos copy list "$oid" --copy-name "$copy" -o status)
    if [[ "$status" != "$expected" ]]; then
        error "Copy '$copy' should be '$expected', got '$status'"
    fi
}

function get_extent_info
{
    local oid=$1
    local copy=$2
    local column=$3

    $phobos extent list -f json -o "$column" -c "$copy" "$oid" |
        jq -r ".[0].$column[]"
}

function copy_extent_count
{
    local oid=$1
    local copy=$2

    $phobos extent list -o ext_count -c "$copy" "$oid"
}

function copy_expected_extent_count
{
    local layout=$1
    local nb_split=$2
    local repl_count=$3

    if [[ "$layout" == "raid1" ]]; then
        echo $((nb_split * repl_count))
    else
        echo $((nb_split * 3))
    fi
}

function stat_should_be
{
    local media=$1
    local field=$2
    local expected=$3

    local value="$($phobos dir list -o "$field" "$media")"
    if [[ "$value" != "$expected" ]]; then
        error "Media '$media' $field should be '$expected', got '$value'"
    fi
}

function extent_xattrs
{
    local extent=$1

    getfattr -d -e text "$extent" 2>/dev/null |
        sed '/^#/d;/^[[:space:]]*$/d'
}

function dump_extent_list
{
    local oid=$1
    local copy=$2

    $phobos extent list -f json -o all -c "$copy" "$oid" |
        jq -S '.[0] | del(.media_name, .address, .ext_uuid, .creation_time)'
}

function contains()
{
    local needle="$1"
    shift

    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done

    return 1
}

function test_copy_rebuild_complete_incomplete
{
    $phobos put -f dir "$INPUT_FILE" oid1

    $valg_phobos copy rebuild oid1 source ||
        error "Copy rebuild on complete copy should have succeeded"

    copy_status_should_be oid1 source complete

    $phobos put -f dir -l raid1 --lyt-params repl_count=2 "$INPUT_FILE" oid2

    waive_lrs
    local media=($(get_extent_info oid2 source media_name))
    $phobos dir delete --lost ${media[@]}
    invoke_lrs

    copy_status_should_be oid2 source incomplete

    $valg_phobos copy rebuild oid2 source &&
        error "Copy rebuild on incomplete copy should have failed"

    return 0
}

function make_put
{
    local layout=$1
    local repl_count=$2

    if [[ $layout == "raid1" ]]; then
        $phobos put -f dir -l raid1 --lyt-params repl_count=$repl_count \
                    -m "blob=toto" "$INPUT_FILE" oid
    else
        $phobos put -f dir -l raid4 -m "blob=toto" "$INPUT_FILE" oid
    fi
}

function test_copy_rebuild_impl
{
    local layout=$1
    local nb_split=$2
    if [[ "$layout" == "raid1" ]]; then
        local repl_count=$3
        shift 3
    else
        local repl_count=3
        shift 2
    fi
    local lost_idxs=("$@")

    make_put $layout $repl_count

    local initial_addresses=($(get_extent_info oid source address))
    local initial_media=($(get_extent_info oid source media_name))
    local old_extent_list=$(dump_extent_list oid source)
    local surviving_extents=()
    local surviving_media=()
    local media_to_delete=()
    local deleted_extents=()
    local deleted_xattrs=()
    local deleted_sizes=()

    # Retrieve media and extents to delete
    for lost_idx in ${lost_idxs[@]}; do
        local deleted_medium="${initial_media[$lost_idx]}"
        local deleted_extent="$deleted_medium/${initial_addresses[$lost_idx]}"

        media_to_delete+=("$deleted_medium")
        deleted_extents+=("$deleted_extent")
        deleted_xattrs+=("$(extent_xattrs "$deleted_extent")")
        deleted_sizes+=("$($phobos dir list -o "stats.logc_spc_used" \
                            "$deleted_medium")")
    done

    # Retrieving the media not deleted for each split
    # For each extent we are deleting, we retrieve it's split and get all the
    # media not deleted
    local i=0
    while (( $i < ${#lost_idxs[@]} )); do
        local idx=${lost_idxs[$i]}
        local current_split=$(( idx / $repl_count))
        local first_idx_split=$((current_split * repl_count))
        local first_next_idx_split=$(( (current_split + 1) * repl_count))

        for j in $(seq $first_idx_split $(( $first_next_idx_split - 1))); do
            if contains "$j" "${lost_idxs[@]}"; then
                continue
            else
                local surviving_medium="${initial_media[$j]}"

                # Skip medium already in surviving media. Only if we have
                # deleted more than one extent in a split
                if contains "$surviving_medium" "${surviving_media[@]}"; then
                    continue
                fi

                surviving_media+=("$surviving_medium")
                surviving_extents+=("$surviving_medium/${initial_addresses[$j]}")
            fi
        done

        i=$(( i + 1))
    done

    waive_lrs
    $phobos dir delete --lost ${media_to_delete[@]}
    invoke_lrs

    copy_status_should_be oid source readable

    $valg_phobos copy rebuild oid source ||
        error "Copy rebuild should have succeeded"

    copy_status_should_be oid source complete

    local extent_count=$(copy_extent_count oid source)
    local expected_count=$(copy_expected_extent_count $layout $nb_split \
                            $repl_count)
    if (( extent_count != expected_count )); then
        error "There should be $expected_count extents after rebuild," \
              "got $extent_count"
    fi

    local rebuilt_media=($(get_extent_info oid source media_name))
    local rebuilt_addresses=($(get_extent_info oid source address))

    for i in $(seq 0 $((${#lost_idxs[@]} - 1))); do
        local idx=${lost_idxs[$i]}
        local rebuilt_extent="${rebuilt_media[$idx]}/${rebuilt_addresses[$idx]}"

        diff <(printf '%s\n' "${deleted_xattrs[$i]}") \
             <(extent_xattrs "$rebuilt_extent") ||
            error "Rebuilt extent $idx xattrs should match the deleted " \
                  "extent xattrs"

        diff -q "${deleted_extents[$i]}" "$rebuilt_extent" ||
            error "Rebuilt extent $idx data should match the deleted " \
                  "extent data"
    done

    if [[ "$old_extent_list" != "$(dump_extent_list oid source)" ]]; then
        error "Phobos extent list should be unchanged"
    fi

    # Lock the surviving media to use only the rebuilt extents
    if [[ "$layout" == "raid1" ]]; then
        for surviving_medium in ${surviving_media[@]}; do
            $phobos dir lock "$surviving_medium"
        done
    else
        # RAID4 has two surviving media per rebuilt split. Lock one of them to
        # force the get to use the rebuilt extent.
        for i in $(seq 0 2 $((${#surviving_media[@]} - 1))); do
            $phobos dir lock "${surviving_media[$i]}"
        done
    fi

    $phobos get oid "$DIR_TEST_OUT/out"

    diff -q "$INPUT_FILE" "$DIR_TEST_OUT/out" ||
        error "Get output should match the original object"

    for i in $(seq 0 $((${#lost_idxs[@]} - 1))); do
        local idx=${lost_idxs[$i]}
        local rebuilt_medium="${rebuilt_media[$idx]}"
        local extent_size="${deleted_sizes[$i]}"

        stat_should_be "$rebuilt_medium" stats.nb_obj 1
        stat_should_be "$rebuilt_medium" stats.logc_spc_used "$extent_size"
    done
}

function test_copy_rebuild_raid1_2_replica
{
    test_copy_rebuild_impl raid1 1 2 0
}

function test_copy_rebuild_raid1_3_replica
{
    test_copy_rebuild_impl raid1 1 3 0 1
}

function test_copy_rebuild_raid4_first_half
{
    test_copy_rebuild_impl raid4 1 0
}

function test_copy_rebuild_raid4_second_half
{
    test_copy_rebuild_impl raid4 1 1
}

function test_copy_rebuild_raid4_xor
{
    test_copy_rebuild_impl raid4 1 2
}

function test_copy_rebuild_raid1_avoid_medium
{
    $phobos put -f dir --tags "rebuild" -l raid1 --lyt-params repl_count=3 \
            "$INPUT_FILE" oid

    local initial_media=($(get_extent_info oid source media_name))
    local lost_medium="${initial_media[0]}"
    local locked_medium="${initial_media[2]}"

    waive_lrs
    $phobos dir delete --lost "$lost_medium"
    invoke_lrs

    $phobos dir lock "${DIRS[3]}"

    copy_status_should_be oid source readable

    $valg_phobos copy rebuild oid source &&
        error "Copy rebuild should have failed without a writable medium"

    return 0
}

function test_copy_rebuild_raid1_split_first_missing
{
    test_copy_rebuild_impl raid1 3 2 0
}

function test_copy_rebuild_raid1_split_second_missing
{
    test_copy_rebuild_impl raid1 3 2 2
}

function test_copy_rebuild_raid1_split_third_missing
{
    test_copy_rebuild_impl raid1 3 2 4
}

function test_copy_rebuild_raid1_split_first_second_missing
{
    test_copy_rebuild_impl raid1 3 2 0 2
}

function test_copy_rebuild_raid1_split_first_third_missing
{
    test_copy_rebuild_impl raid1 3 2 0 4
}

function test_copy_rebuild_raid1_split_second_third_missing
{
    test_copy_rebuild_impl raid1 3 2 2 4
}

function test_copy_rebuild_raid1_split_all_missing
{
    test_copy_rebuild_impl raid1 3 2 0 2 4
}

function test_copy_rebuild_raid4_split_all_missing_first_half
{
    test_copy_rebuild_impl raid4 2 0 3
}

function test_copy_rebuild_raid4_split_all_missing_second_half
{
    test_copy_rebuild_impl raid4 2 1 4
}

function test_copy_rebuild_raid4_split_all_missing_xor
{
    test_copy_rebuild_impl raid4 2 2 5
}

function test_copy_rebuild_invalid_extent_idx
{
    $phobos put -f dir -l raid1 --lyt-params repl_count=2 "$INPUT_FILE" oid

    $valg_phobos copy rebuild oid source --extent-idx=-1,0 &&
        error "phobos copy rebuild should have failed"

    $valg_phobos copy rebuild oid source -e 0,50 &&
        error "phobos copy rebuild should have failed"

    $valg_phobos copy rebuild oid source -e 0,aa &&
        error "phobos copy rebuild should have failed"

    exit 0
}

function test_copy_rebuild_duplicate_extent_idx
{
    $phobos put -f dir -l raid1 --lyt-params repl_count=3 "$INPUT_FILE" oid

    local initial_media=($(get_extent_info oid source media_name))

    waive_lrs
    $phobos dir delete --lost "${initial_media[1]}"
    invoke_lrs

    copy_status_should_be oid source readable

    # Duplicated extent indexes must only be rebuilt once
    $valg_phobos copy rebuild oid source -e 1,1

    copy_status_should_be oid source complete

    local extent_count=$(copy_extent_count oid source)
    if (( extent_count != 3 )); then
        error "There should be 3 extents after rebuild, got $extent_count"
    fi

    $phobos dir lock ${initial_media[0]} ${initial_media[2]}
    $phobos get oid "$DIR_TEST_OUT/out"

    diff -q "$INPUT_FILE" "$DIR_TEST_OUT/out" ||
        error "Get output should match the original object"
}

function test_copy_rebuild_all_present_extents
{
    $phobos put -f dir -l raid1 --lyt-params repl_count=3 "$INPUT_FILE" oid

    local initial_media=($(get_extent_info oid source media_name))

    waive_lrs
    $phobos dir delete --lost "${initial_media[2]}"
    invoke_lrs

    copy_status_should_be oid source readable

    # Rebuilding all the present extents of a split would leave no extent to
    # read the data from
    $valg_phobos copy rebuild oid source -e 0,1 &&
        error "Phobos copy rebuild should have failed"

    exit 0
}

function test_copy_rebuild_corrupted_source
{
    $phobos put -f dir -l raid1 --lyt-params repl_count=2 "$INPUT_FILE" oid

    local addresses=($(get_extent_info oid source address))
    local media=($(get_extent_info oid source media_name))

    # Corrupt the extent 0, the rebuild of the extent 1 will fail on it
    echo "a" >> "${media[0]}/${addresses[0]}"

    $valg_phobos copy rebuild oid source -e 1 &&
        error "Rebuild from a corrupted extent should have failed"

    exit 0
}

TESTS=("setup; test_copy_rebuild_complete_incomplete; cleanup"
       "setup_avoid; test_copy_rebuild_raid1_avoid_medium; cleanup"
       "setup; test_copy_rebuild_invalid_extent_idx; cleanup"
       "setup; test_copy_rebuild_duplicate_extent_idx; cleanup"
       "setup; test_copy_rebuild_all_present_extents; cleanup"
       "setup; test_copy_rebuild_corrupted_source; cleanup")

################################################################################
##############################       RAID1      ################################
################################################################################

TESTS+=("setup; test_copy_rebuild_raid1_2_replica; cleanup"
        "setup; test_copy_rebuild_raid1_3_replica; cleanup"
        "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_first_missing; \
        cleanup_split_rebuild"
       "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_second_missing; \
        cleanup_split_rebuild"
       "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_third_missing; \
        cleanup_split_rebuild"
       "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_first_second_missing; \
        cleanup_split_rebuild"
       "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_first_third_missing; \
        cleanup_split_rebuild"
       "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_second_third_missing; \
        cleanup_split_rebuild"
       "setup_split_rebuild; \
            test_copy_rebuild_raid1_split_all_missing; \
        cleanup_split_rebuild")

################################################################################
##############################       RAID4      ################################
################################################################################

TESTS+=("setup; test_copy_rebuild_raid4_first_half; cleanup"
        "setup; test_copy_rebuild_raid4_second_half; cleanup"
        "setup; test_copy_rebuild_raid4_xor; cleanup"
        "setup_split_rebuild; \
            test_copy_rebuild_raid4_split_all_missing_first_half; \
         cleanup_split_rebuild"
        "setup_split_rebuild; \
            test_copy_rebuild_raid4_split_all_missing_second_half; \
         cleanup_split_rebuild"
        "setup_split_rebuild; \
            test_copy_rebuild_raid4_split_all_missing_xor; \
         cleanup_split_rebuild"
        "setup_split_rebuild odd; \
            test_copy_rebuild_raid4_split_all_missing_first_half; \
         cleanup_split_rebuild"
        "setup_split_rebuild odd; \
            test_copy_rebuild_raid4_split_all_missing_second_half; \
         cleanup_split_rebuild"
        "setup_split_rebuild odd; \
            test_copy_rebuild_raid4_split_all_missing_xor; \
         cleanup_split_rebuild")
