#
# Test the media refresh_gc_stats command
#

test_dir=$(dirname $(readlink -e $0))
. $test_dir/test_env.sh
. $test_dir/setup_db.sh
. $test_dir/tape_drive.sh
. $test_dir/test_launch_daemon.sh
. $test_dir/utils_generation.sh

# logical size of the put files, so that each GC counter has its own value
FILE_LIVE_SIZE=2048
FILE_DEPRECATED_SIZE=1024
FILE_OVERWRITTEN_SIZE=512
FILE_ORPHANED_SIZE=4096
FILE_REMOVED_SIZE=8192

GC_ATTRS="stats.nb_extent_deprecated,stats.logc_spc_deprecated,"\
"stats.nb_extent_orphan,stats.logc_spc_orphan"
FULL_ATTRS="stats.nb_extent,stats.logc_spc_used,$GC_ATTRS"
RATIO_ATTRS="stats.deprecated_ratio,stats.deprecated_nb_ratio,"\
"stats.orphan_ratio,stats.orphan_nb_ratio"

function setup_files
{
    FILE_LIVE="$DIR_TEST_IN/file_live"
    FILE_DEPRECATED="$DIR_TEST_IN/file_deprecated"
    FILE_OVERWRITTEN="$DIR_TEST_IN/file_overwritten"
    FILE_ORPHANED="$DIR_TEST_IN/file_orphaned"
    FILE_REMOVED="$DIR_TEST_IN/file_removed"

    dd if=/dev/urandom of="$FILE_LIVE" bs=$FILE_LIVE_SIZE count=1 &>/dev/null
    dd if=/dev/urandom of="$FILE_DEPRECATED" bs=$FILE_DEPRECATED_SIZE \
        count=1 &>/dev/null
    dd if=/dev/urandom of="$FILE_OVERWRITTEN" bs=$FILE_OVERWRITTEN_SIZE \
        count=1 &>/dev/null
    dd if=/dev/urandom of="$FILE_ORPHANED" bs=$FILE_ORPHANED_SIZE \
        count=1 &>/dev/null
    dd if=/dev/urandom of="$FILE_REMOVED" bs=$FILE_REMOVED_SIZE \
        count=1 &>/dev/null

    export FILE_LIVE FILE_DEPRECATED FILE_OVERWRITTEN FILE_ORPHANED \
           FILE_REMOVED
}

function check_stats
{
    local family=$1
    local medium=$2
    local attrs=$3
    local expected_row=$4
    local out
    local expected

    out=$($valg_phobos "$family" list "$medium" -f csv -o "$attrs")

    # the csv dialect terminates each line with \r\n
    out=${out//$'\r'/}

    expected="$attrs"$'\n'"$expected_row"
    [[ "$out" == "$expected" ]] ||
        error "unexpected stats of $family medium '$medium': got '$out', "\
"expected '$expected'"
}

# Extract the data row of the human table displayed by the stats
# command, as a comma-separated list of its cells: the ratio values are
# rendered as percentages, which only appear in the data rows of the
# table
function human_stats_row
{
    local family=$1
    local medium=$2
    local attrs=$3

    $phobos "$family" list "$medium" -o "$attrs" | awk -F'|' '
        /%/ {
            n = 0
            for (i = 1; i <= NF; i++) {
                cell = $i
                gsub(/^ +| +$/, "", cell)
                if (cell != "")
                    val[++n] = cell
            }

            row = val[1]
            for (i = 2; i <= n; i++)
                row = row "," val[i]
            print row
        }'
}

# Check the ratios of a medium in the default human format, which
# renders them as percentages
function check_ratios
{
    local family=$1
    local medium=$2
    local expected_row=$3
    local row

    row=$(human_stats_row "$family" "$medium" "$RATIO_ATTRS")

    [[ "$row" == "$expected_row" ]] ||
        error "unexpected ratios of $family medium '$medium': got '$row', "\
"expected '$expected_row'"
}

# Check the occupancy of a medium in the human format: the human output
# of a single attribute displays the raw ratio, the percentage is
# rendered only when it is displayed along with other attributes
function check_occupancy
{
    local family=$1
    local medium=$2
    local expected=$3
    local row
    local occupancy

    row=$(human_stats_row "$family" "$medium" "stats.occupancy,$RATIO_ATTRS")
    occupancy=${row%%,*}

    [[ "$occupancy" == "$expected" ]] ||
        error "unexpected occupancy of $family medium '$medium': got "\
"'$occupancy', expected '$expected'"
}

# The occupancy of a medium with data depends on the physical space of
# its underlying filesystem, which is not controlled by this test: only
# check that some data occupies the medium. The human format would
# display 0.00%, as the test data is negligible compared to the capacity
# of any real medium: check the raw value in csv instead.
function check_occupancy_range
{
    local family=$1
    local medium=$2
    local out

    out=$($phobos "$family" list "$medium" -f csv -o stats.occupancy)

    # the csv dialect terminates each line with \r\n
    out=${out//$'\r'/}

    echo "$out" | awk -F, '
        NR == 2 {
            found = 1
            if ($1 + 0 <= 0 || $1 + 0 >= 1) {
                failed = 1
                exit
            }
        }
        END { if (!found || failed) exit 1 }' ||
        error "occupancy of $family medium '$medium' should be in ]0,1[, "\
"got '$out'"
}

function setup_dir
{
    setup_tables
    invoke_lrs

    setup_test_dirs
    setup_files

    # two dir media in different libraries, and an empty one to check
    # that a refresh also publishes null counters
    DIR_LEGACY="$DIR_TEST_IN/dir_legacy"
    DIR_OTHERLIB="$DIR_TEST_IN/dir_otherlib"
    DIR_EMPTY="$DIR_TEST_IN/dir_empty"
    export DIR_LEGACY DIR_OTHERLIB DIR_EMPTY

    mkdir "$DIR_LEGACY" "$DIR_OTHERLIB" "$DIR_EMPTY"
    $phobos dir add --tags statA "$DIR_LEGACY"
    $phobos dir add --library otherlib "$DIR_OTHERLIB"
    $phobos dir add --tags statE "$DIR_EMPTY"
    $phobos dir format --fs posix --unlock "$DIR_LEGACY" "$DIR_EMPTY"
    $phobos dir format --fs posix --unlock --library otherlib "$DIR_OTHERLIB"

    # DIR_LEGACY: a live extent, a deprecated extent (soft delete) and a
    # second deprecated extent (first version of an overwritten object)
    $phobos put -f dir --tags statA "$FILE_LIVE" oid_dir_live
    $phobos put -f dir --tags statA "$FILE_DEPRECATED" oid_dir_deprecated
    $phobos del oid_dir_deprecated
    $phobos put -f dir --tags statA "$FILE_OVERWRITTEN" oid_dir_overwritten
    $phobos put -f dir --tags statA --overwrite "$FILE_OVERWRITTEN" \
        oid_dir_overwritten

    # DIR_OTHERLIB: a deprecated extent (soft delete) and a hard deleted
    # one, which is physically removed from a directory instead of being
    # orphan
    $phobos put -f dir --library otherlib "$FILE_DEPRECATED" \
        oid_dir2_deprecated
    $phobos del oid_dir2_deprecated
    $phobos put -f dir --library otherlib "$FILE_REMOVED" oid_dir2_removed
    $phobos del --hard oid_dir2_removed
}

function cleanup_dir
{
    waive_lrs

    cleanup_test_dirs

    drop_tables
}

function setup_tape
{
    setup_tables
    invoke_daemons

    setup_test_dirs
    setup_files

    local drive
    local tapes

    drive="$(get_lto_drives 6 1)"
    tapes=( $(get_tapes L6 2 | nodeset -e) )
    TAPE_STAT_A="${tapes[0]}"
    TAPE_STAT_B="${tapes[1]}"
    export TAPE_STAT_A TAPE_STAT_B

    $phobos drive add --unlock "$drive"
    $phobos tape add -t lto6 --tags statA "$TAPE_STAT_A"
    $phobos tape add -t lto6 --tags statB "$TAPE_STAT_B"
    $phobos tape format --unlock "$TAPE_STAT_A" "$TAPE_STAT_B"

    # TAPE_STAT_A: a live extent, a deprecated extent (soft delete) and
    # an orphan extent (hard delete on tape)
    $phobos put -f tape --tags statA "$FILE_LIVE" oid_tape_live
    $phobos put -f tape --tags statA "$FILE_DEPRECATED" oid_tape_deprecated
    $phobos del oid_tape_deprecated
    $phobos put -f tape --tags statA "$FILE_ORPHANED" oid_tape_orphaned
    $phobos del --hard oid_tape_orphaned

    # TAPE_STAT_B: a deprecated extent only
    $phobos put -f tape --tags statB "$FILE_DEPRECATED" oid_tape2_deprecated
    $phobos del oid_tape2_deprecated
}

function cleanup_tape
{
    waive_daemons

    drain_all_drives
    cleanup_test_dirs

    drop_tables
}

function test_dir_stats_before_refresh
{
    # the GC counters are null before any refresh, while the live
    # counters already account for the extents written on the media
    check_stats dir "$DIR_LEGACY" "$FULL_ATTRS" \
        "4,4096,0,0,0,0"
    check_stats dir "$DIR_OTHERLIB" "$FULL_ATTRS" \
        "1,1024,0,0,0,0"
    check_stats dir "$DIR_EMPTY" "$FULL_ATTRS" \
        "0,0,0,0,0,0"
}

function test_dir_stats_refresh_time
{
    local ts=$($valg_phobos dir list "$DIR_EMPTY" -o stats.last_gc_refresh)
    [[ "$ts" == "None" ]] ||
        error "unexpected last refresh time of '$DIR_EMPTY' before any "\
              "refresh: '$ts'"

    local before=$(date +%s)
    $valg_phobos dir refresh_gc_stats "$DIR_EMPTY" ||
        error "refresh of $DIR_EMPTY failed"
    local after=$(date +%s)

    # the last refresh time is the time of the refresh command
    ts=$($valg_phobos dir list "$DIR_EMPTY" -o stats.last_gc_refresh)
    local ts_epoch=$(date -d "$ts" +%s)
    [[ $ts_epoch -ge $before && $ts_epoch -le $after ]] ||
        error "last refresh time of '$DIR_EMPTY' is '$ts', expected in the "\
              "refresh execution window [$before, $after]"

    sleep 2

    $valg_phobos dir refresh_gc_stats "$DIR_EMPTY" ||
        error "second refresh of $DIR_EMPTY failed"

    ts=$($valg_phobos dir list "$DIR_EMPTY" -o stats.last_gc_refresh)
    local new_ts_epoch=$(date -d "$ts" +%s)
    [[ $new_ts_epoch -gt $ts_epoch ]] ||
        error "last refresh time of '$DIR_EMPTY' did not move forward on a "\
               "new refresh: '$ts'"
}

function test_dir_stats_refresh_tags_scope
{
    # the tag option combines with the library option: no medium of the
    # otherlib library carries the statA tag, nothing is refreshed
    $valg_phobos dir refresh_gc_stats --tags statA --library otherlib ||
        error "refresh of the statA media of the otherlib library failed"

    # DIR_LEGACY, which carries the tag, belongs to another library and
    # DIR_OTHERLIB, which belongs to the library, does not carry the
    # tag: none of them is refreshed
    check_stats dir "$DIR_LEGACY" "$GC_ATTRS" "0,0,0,0"
    check_stats dir "$DIR_OTHERLIB" "$GC_ATTRS" "0,0,0,0"

    # with named media, only those carrying the requested tag are
    # refreshed
    $valg_phobos dir refresh_gc_stats --tags statE "$DIR_LEGACY" \
        "$DIR_EMPTY" ||
        error "refresh of the statE media failed"

    check_stats dir "$DIR_LEGACY" "$GC_ATTRS" "0,0,0,0"

    # refresh all the media carrying the tag, without naming them
    $valg_phobos dir refresh_gc_stats --tags statA ||
        error "refresh of the statA media failed"

    check_stats dir "$DIR_LEGACY" "$GC_ATTRS" "2,1536,0,0"
    check_stats dir "$DIR_OTHERLIB" "$GC_ATTRS" "0,0,0,0"
    check_stats dir "$DIR_EMPTY" "$GC_ATTRS" "0,0,0,0"
}

function test_dir_stats_refresh_library_scope
{
    # refresh all the media of the other library, without naming them:
    # the media of the other libraries are not refreshed
    $valg_phobos dir refresh_gc_stats --library otherlib ||
        error "refresh of the otherlib library failed"

    # the media of the other libraries are not refreshed: they keep the
    # counters of their last refresh, by tags for DIR_LEGACY
    check_stats dir "$DIR_OTHERLIB" "$GC_ATTRS" "1,1024,0,0"
    check_stats dir "$DIR_LEGACY" "$GC_ATTRS" "2,1536,0,0"
    check_stats dir "$DIR_EMPTY" "$GC_ATTRS" "0,0,0,0"
}

function test_dir_stats_refresh_scope
{
    # refresh a single medium of the other library: only this medium is
    # refreshed, the media of the other libraries keep the counters of
    # their last refresh
    $valg_phobos dir refresh_gc_stats --library otherlib "$DIR_OTHERLIB" ||
        error "refresh of $DIR_OTHERLIB failed"

    check_stats dir "$DIR_OTHERLIB" "$GC_ATTRS" "1,1024,0,0"
    check_stats dir "$DIR_LEGACY" "$GC_ATTRS" "2,1536,0,0"
}

function test_dir_stats_refresh
{
    # refresh all the dir media: the deprecated extents of DIR_LEGACY are
    # published, the live counters are preserved and the already
    # refreshed counters of DIR_OTHERLIB are replaced, not added
    $valg_phobos dir refresh_gc_stats ||
        error "refresh of the dir family failed"

    check_stats dir "$DIR_LEGACY" "$FULL_ATTRS" \
        "4,4096,2,1536,0,0"
    check_stats dir "$DIR_OTHERLIB" "$GC_ATTRS" "1,1024,0,0"
    check_stats dir "$DIR_EMPTY" "$GC_ATTRS" "0,0,0,0"
}

function test_dir_stats_ratios
{
    # the ratios of the dir media are computed from their logical
    # counters, which are all checked with fixed values
    check_ratios dir "$DIR_LEGACY" "37.50%,50.00%,0.00%,0.00%"
    check_ratios dir "$DIR_OTHERLIB" "100.00%,100.00%,0.00%,0.00%"

    # the counters of an empty medium are all null: its ratios are null
    # too, whatever its physical capacity
    check_ratios dir "$DIR_EMPTY" "0.00%,0.00%,0.00%,0.00%"
    check_occupancy dir "$DIR_EMPTY" "0.00%"

    check_occupancy_range dir "$DIR_LEGACY"
}

function test_dir_stats_stale_without_refresh
{
    # a new deprecated extent on DIR_EMPTY: the plain stats command is
    # read-only and still displays the last refreshed counters
    $phobos put -f dir --tags statE "$FILE_DEPRECATED" oid_dir_empty_deprecated
    $phobos del oid_dir_empty_deprecated

    check_stats dir "$DIR_EMPTY" "$GC_ATTRS" "0,0,0,0"

    $valg_phobos dir refresh_gc_stats "$DIR_EMPTY" ||
        error "refresh of $DIR_EMPTY failed"

    check_stats dir "$DIR_EMPTY" "$GC_ATTRS" "1,1024,0,0"
    check_ratios dir "$DIR_EMPTY" "100.00%,100.00%,0.00%,0.00%"
}

function test_media_stats_sort_attr
{
    local family=$1
    local operator=$2
    local attr=$3
    local exp=$4

    if [ -z "$exp" ]; then
        if [[ $operator == "--sort" ]]; then
            exp="$($valg_phobos $family list -o $attr | sort)"
        else
            exp="$($valg_phobos $family list -o $attr | sort -r)"
        fi
    fi

    local res="$($valg_phobos $family list -o $attr $operator $attr)"
    if [[ "$res" != "$exp" ]]; then
        error "phobos $family list -o $attr $operator $attr output is" \
              "different than expected: $exp"
    fi
}

function test_dir_stats_sort
{
    test_media_stats_sort_attr dir --sort name
    test_media_stats_sort_attr dir --sort 'stats.nb_extent'
    test_media_stats_sort_attr dir --sort 'stats.logc_spc_used'
    # the deprecated counters come from the last refresh of each dir: two
    # deprecated extents on the legacy dir, a single one on each other dir
    test_media_stats_sort_attr dir --sort 'stats.nb_extent_deprecated' \
        $'1\n1\n2'
    test_media_stats_sort_attr dir --sort 'stats.logc_spc_deprecated' \
        $'1024\n1024\n1536'

    test_media_stats_sort_attr dir --rsort name
    test_media_stats_sort_attr dir --rsort 'stats.nb_extent'
    test_media_stats_sort_attr dir --rsort 'stats.logc_spc_used'
    test_media_stats_sort_attr dir --rsort 'stats.nb_extent_deprecated' \
        $'2\n1\n1'
    test_media_stats_sort_attr dir \
        --rsort 'stats.logc_spc_deprecated' $'1536\n1024\n1024'

    # all the dirs have been written to, so they share the same fs status:
    # only the reverse sort on their name decides the output order
    local exp="$($valg_phobos dir list -o name | sort -r)"
    local res="$($valg_phobos dir list -o name --sort fs.status --rsort name)"
    if [[ "$res" != "$exp" ]]; then
        error "phobos dir list -o name --sort fs.status --rsort name" \
              "output is different than expected: $exp"
    fi

    # the sort attributes can also be given as a comma-separated list
    res="$($valg_phobos dir list -o stats.nb_extent_deprecated \
        --sort stats.nb_extent_deprecated,stats.logc_spc_deprecated)"
    exp="$($valg_phobos dir list -o stats.nb_extent_deprecated | sort)"
    if [[ "$res" != "$exp" ]]; then
        error "phobos dir list -o stats.nb_extent_deprecated --sort" \
              "stats.nb_extent_deprecated,stats.logc_spc_deprecated output is" \
              "different than expected: $exp"
    fi
}

function test_tape_stats_before_refresh
{
    check_stats tape "$TAPE_STAT_A" "$GC_ATTRS" "0,0,0,0"
    check_stats tape "$TAPE_STAT_B" "$GC_ATTRS" "0,0,0,0"
}

function test_tape_stats_refresh_scope
{
    # refresh a single medium of the default library, without the library
    # option
    $valg_phobos tape refresh_gc_stats "$TAPE_STAT_A" ||
        error "refresh of $TAPE_STAT_A failed"

    check_stats tape "$TAPE_STAT_A" "$GC_ATTRS" "1,1024,1,4096"
    check_stats tape "$TAPE_STAT_B" "$GC_ATTRS" "0,0,0,0"

    # several media can be refreshed by a single command
    $valg_phobos tape refresh_gc_stats "$TAPE_STAT_A" "$TAPE_STAT_B" ||
        error "refresh of the two tapes failed"

    check_stats tape "$TAPE_STAT_A" "$GC_ATTRS" "1,1024,1,4096"
    check_stats tape "$TAPE_STAT_B" "$GC_ATTRS" "1,1024,0,0"
}

function test_tape_stats_refresh
{
    # refresh all the tape media: the hard deleted extent of TAPE_STAT_A
    # is orphan on tape, where the data cannot be reclaimed
    $valg_phobos tape refresh_gc_stats ||
        error "refresh of the tape family failed"

    check_stats tape "$TAPE_STAT_A" "$GC_ATTRS" "1,1024,1,4096"
    check_stats tape "$TAPE_STAT_B" "$GC_ATTRS" "1,1024,0,0"
}

function test_tape_stats_ratios
{
    # TAPE_STAT_B holds a single deprecated extent: its deprecated
    # ratios are total
    check_stats tape "$TAPE_STAT_B" "$FULL_ATTRS" "1,1024,1,1024,0,0"
    check_ratios tape "$TAPE_STAT_B" "100.00%,100.00%,0.00%,0.00%"

    # the space of a tape cannot be reclaimed: deleting an object does
    # not change the live counters of its tape, which keep accounting
    # every extent ever written, deprecated or orphan
    check_stats tape "$TAPE_STAT_A" "$FULL_ATTRS" "3,7168,1,1024,1,4096"
    check_ratios tape "$TAPE_STAT_A" "14.29%,33.33%,57.14%,33.33%"

    check_occupancy_range tape "$TAPE_STAT_A"
}

function test_tape_stats_refresh_idempotent
{
    # a second refresh replaces the counters, it does not add to them
    $valg_phobos tape refresh_gc_stats ||
        error "refresh of the tape family failed"

    check_stats tape "$TAPE_STAT_A" "$GC_ATTRS" "1,1024,1,4096"
    check_stats tape "$TAPE_STAT_B" "$GC_ATTRS" "1,1024,0,0"
}

TESTS=("setup_dir; \
            test_dir_stats_before_refresh; \
            test_dir_stats_refresh_time; \
            test_dir_stats_refresh_tags_scope; \
            test_dir_stats_refresh_library_scope; \
            test_dir_stats_refresh_scope; \
            test_dir_stats_refresh; \
            test_dir_stats_ratios; \
            test_dir_stats_stale_without_refresh; \
            test_dir_stats_sort; \
        cleanup_dir")

if [[ -w /dev/changer ]]; then
    TESTS+=("setup_tape; \
                test_tape_stats_before_refresh; \
                test_tape_stats_refresh_scope; test_tape_stats_refresh; \
                test_tape_stats_ratios; \
                test_tape_stats_refresh_idempotent; \
            cleanup_tape")
fi
