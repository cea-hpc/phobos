#
# Integration test for phobos_hsm_release_dir
#

test_dir=$(dirname $(readlink -e $0))
. $test_dir/test_env.sh
. $test_dir/setup_db.sh
. $test_dir/test_launch_daemon.sh
. $test_dir/utils_generation.sh

function setup
{
    setup_tables

    setup_test_dirs
    setup_dummy_files 1 1k 100k

    export PHOBOS_LRS_families="dir"
    export PHOBOS_STORE_default_family="dir"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_error_log_path="${DIR_TEST}/hsm_error"
    rm -f ${PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_error_log_path}

    invoke_lrs

    dir_other_host="$DIR_TEST_IN/dir_other_host"
    mkdir ${dir_other_host}
    $phobos dir add --tags other_host ${dir_other_host}
    $phobos dir format --unlock --fs posix --unlock ${dir_other_host}

    dir_to_release_1G=$(make_tmp_fs 1G)
    $phobos dir add --tags to_release ${dir_to_release_1G}
    $phobos dir format --fs posix --unlock ${dir_to_release_1G}

    sync_dir="$DIR_TEST_IN/dir_to_sync"
    mkdir ${sync_dir}
    $phobos dir add --tags for_sync ${sync_dir}
    $phobos dir format --fs posix --unlock ${sync_dir}
}

function cleanup
{
    waive_lrs

    cleanup_dummy_files
    cleanup_tmp_fs ${dir_to_release_1G}
    cleanup_test_dirs

    drop_tables
}

function check_hsm_release_dir_opt()
{
    $valg_phobos_hsm_release_dir --bad_opt && error "--bad_opt parsing must fail"

    local usage=$($valg_phobos_hsm_release_dir -h)
    local usage_long=$($valg_phobos_hsm_release_dir --help)

    if [[ "$usage" != "$usage_long" ]]; then
        error "-h and --help must show the same usage"
    fi

    (echo ${usage} | grep usage) || error "-h must show usage"
}

function check_copy()
{
    local oid=$1
    local expected_copies=("${@:2}")

    local copies=()
    for copy in `$phobos copy list -d ${oid}`; do
        copies+=(${copy})
    done

    if [[ "${#copies[@]}" != "${#expected_copies[@]}" ]]; then
        error "For oid '$oid', we expected copies '${expected_copies[@]}'" \
              "whereas we get '${copies[@]}'"
    fi

    if [[ "${#copies[@]}" == 0 ]]; then
        return 0
    fi

    for i in `seq 0 $(( ${#copies[@]} - 1 ))`; do
        local found="false"

        for j in `seq 0 $(( ${#expected_copies[@]} - 1 ))`; do
            if [[ "${copies[${i}]}" == "${expected_copies[${j}]}" ]]; then
                found="true"
                break
            fi
        done

        if [[ "${found}" != "true" ]]; then
            error "For oid '$oid', we expected copies '${expected_copies[@]}'" \
                  "whereas we get '${copies[@]}'"
        fi
    done

    for i in `seq 0 $(( ${#expected_copies[@]} - 1 ))`; do
        local found="false"

        for j in `seq 0 $(( ${#copies[@]} - 1 ))`; do
            if [[ "${expected_copies[${i}]}" == "${copies[${j}]}" ]]; then
                found="true"
                break
            fi
        done

        if [[ "${found}" != "true" ]]; then
            error "For oid '$oid', we expected copies '${expected_copies[@]}'" \
                  "whereas we get '${copies[@]}'"
        fi
    done
}

function setup_hsm_release_objects()
{
    # object to release
    $phobos put --metadata k1=v1,other=other --tags to_release \
        --copy-name copy_to_release ${FILES[0]} to_release
    $phobos copy create --tags for_sync to_release copy_synced

    # deprecated object to release
    $phobos put --metadata k2=v2 --tags to_release --copy-name copy_to_release \
        ${FILES[0]} deprec_to_release
    $phobos copy create --tags for_sync deprec_to_release copy_synced
    $phobos delete deprec_to_release

    # last candidate object to release
    $phobos put --tags to_release --copy-name copy_to_release \
        ${FILES[0]} last_to_release
    $phobos copy create --tags for_sync last_to_release copy_synced

    # object not synced
    $phobos put --tags to_release --copy-name copy_to_release \
        ${FILES[0]} not_synced

    # object on a dir of an other host
    $phobos put --tags other_host --copy-name copy_to_release \
        ${FILES[0]} other_host
    $phobos copy create --tags for_sync other_host copy_synced
    $PSQL << EOF
UPDATE device SET host = 'other_host' WHERE path = '${dir_other_host}';
EOF

    # object other copy
    $phobos put --tags to_release --copy-name other ${FILES[0]} other_copy
    $phobos copy create --tags for_sync other_copy copy_synced

    # object too young to be released
    $phobos put --tags to_release --copy-name copy_to_release \
        ${FILES[0]} too_young
    $phobos copy create --tags for_sync too_young copy_synced

    # Pin the creation time of the extents of the old release candidates a
    # few hours in the past, in their creation order, so that they are
    # always older than the release delay below, whatever the time the
    # release tool takes to start and run, whereas too_young, just created,
    # always stays younger than it.
    release_delay_second=3600
    $PSQL << EOF
UPDATE extent SET creation_time = now() - interval '4 hours'
 WHERE extent_uuid IN (SELECT extent_uuid FROM layout
                        WHERE copy_name = 'copy_to_release' AND
                              object_uuid = (SELECT object_uuid FROM object
                                              WHERE oid = 'to_release'));
UPDATE extent SET creation_time = now() - interval '3 hours'
 WHERE extent_uuid IN (SELECT extent_uuid FROM layout
                        WHERE copy_name = 'copy_to_release' AND
                              object_uuid = (SELECT object_uuid
                                               FROM deprecated_object
                                              WHERE oid = 'deprec_to_release'));
UPDATE extent SET creation_time = now() - interval '2 hours'
 WHERE extent_uuid IN (SELECT extent_uuid FROM layout
                        WHERE copy_name = 'copy_to_release' AND
                              object_uuid = (SELECT object_uuid FROM object
                                              WHERE oid = 'last_to_release'));
EOF
    local pinned_extents
    pinned_extents=$($PSQL -t -A -c "SELECT count(*) FROM extent
                                      WHERE creation_time < now() - interval '1 hour'")
    ((pinned_extents == 3)) ||
        error "The extents of to_release, deprec_to_release and" \
              "last_to_release must be the only ones older than one hour," \
              "whereas we count ${pinned_extents}"

    # We have 6 extents of 100M each on the dir_to_release_1G : current fill
    # rate is 60% . The old enough release candidates are to_release,
    # deprec_to_release and last_to_release, with too_young excluded by the
    # release_delay_second parameter.
}

function check_hsm_release_dir()
{
    setup_hsm_release_objects

    # dry-run phobos_hsm_release_dir with a too high threshold
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_higher_threshold="99"
    dry_run_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced)
    (echo "${dry_run_log}" | grep "DELETE") &&
        error "Too high threshold dry-run must not show any release"

    # dry-run phobos_hsm_release_dir
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_higher_threshold="1"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_lower_threshold="0"
    dry_run_log=$($valg_phobos_hsm_release_dir -m k1,k2 \
                      copy_to_release copy_synced)
    (echo "${dry_run_log}" | grep "DELETE" | grep "to_release" | \
     grep "copy_to_release" | grep " \"k1\"=\"v1\"") ||
        error "dry-run must show a release of to_release"
    (echo "${dry_run_log}" | grep "DELETE" | grep "deprec_to_release" | \
     grep "copy_to_release" | grep " \"k2\"=\"v2\"") ||
        error "dry-run must show a release of deprec_to_release"

    # base64 dry-run phobos_hsm_release_dir
    dry_run_log=$($valg_phobos_hsm_release_dir -b -m k1,k2 \
                      copy_to_release copy_synced)
    (echo "${dry_run_log}" | grep "DELETE" | grep "to_release" | \
     grep "copy_to_release" | grep " \"k1\"=\"$(echo -n v1 | base64)\"") ||
        error "dry-run must show a release of to_release"
    (echo "${dry_run_log}" | grep "DELETE" | grep "deprec_to_release" | \
     grep "copy_to_release" | grep " \"k2\"=\"$(echo -n v2 | base64)\"") ||
        error "dry-run must show a release of deprec_to_release"

    # run phobos_hsm_release_dir

    # 3 extents are candidates to be released : to_release, deprec_to_release
    # and last_to_release, the extents pinned in the past by the setup
    #
    # 3 extents can not be released : not_synced, other_copy and too_young
    # We exclude the last_to_release with the dir_release_lower_threshold
    # condition.

    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_release_delay_second="${release_delay_second}"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_higher_threshold="55"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_lower_threshold="45"
    run_log=$($valg_phobos_hsm_release_dir -d copy_to_release copy_synced 2>&1)

    # released
    check_copy to_release copy_synced
    check_copy deprec_to_release copy_synced
    # not released
    check_copy last_to_release copy_to_release copy_synced
    check_copy not_synced copy_to_release
    check_copy other_host copy_to_release copy_synced
    check_copy other_copy other copy_synced
    check_copy too_young copy_to_release copy_synced
}

# Run a specific threshold release scenario with the specific higher and
# lower thresholds given as first and second arguments: the release of the
# objects given as next arguments is checked first in a dry-run, then
# achieved with -d, and every released object is checked to hold only its
# destination copy at the end. The setup objects are expected to be old
# enough to be released.
function run_specific_threshold_release()
{
    local specific_higher_threshold="$1"
    local specific_lower_threshold="$2"
    local released_oids=("${@:3}")
    local delete_count
    local oid

    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_release_delay_second="${release_delay_second}"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_higher_threshold="${specific_higher_threshold}"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_lower_threshold="${specific_lower_threshold}"

    # dry-run phobos_hsm_release_dir
    dry_run_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced)
    delete_count=$(echo "${dry_run_log}" | grep -c "DELETE" || true)
    ((delete_count == ${#released_oids[@]})) ||
        error "dry-run must show ${#released_oids[@]} releases," \
              "whereas we get ${delete_count}"
    for oid in "${released_oids[@]}"; do
        (echo "${dry_run_log}" | grep "DELETE" | grep "\"${oid}\"") ||
            error "dry-run must show a release of ${oid}"
    done

    # run phobos_hsm_release_dir
    run_log=$($valg_phobos_hsm_release_dir -d copy_to_release copy_synced 2>&1)

    for oid in "${released_oids[@]}"; do
        check_copy "${oid}" copy_synced
    done
}

function check_hsm_release_dir_specific_threshold()
{
    setup_hsm_release_objects

    # The general fill rate of the dir_to_release_1G is about 60%: with a
    # general higher threshold of 99%, only the specific thresholds can
    # trigger a purge. The 3 old enough candidates occupy about 30% of the
    # dir, and the extents of the source copy, selectable for release or
    # not, occupy about 50%.

    # a specific higher threshold greater than or equal to the general
    # higher threshold, like the default value of 100, is ignored: no
    # release happens
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_higher_threshold="99"
    dry_run_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced)
    (echo "${dry_run_log}" | grep "DELETE") &&
        error "Specific threshold above the general threshold must be ignored"

    # with a specific higher threshold of 90%, the specific fill rate of
    # about 50% does not cross it, although the dir holds 3 old release
    # candidates and the specific lower threshold of 15% leaves a positive
    # space to release: no release happens
    run_specific_threshold_release 90 15

    # a specific lower threshold of 27%, upper than the specific higher
    # threshold of 25%, disables the specific release: no release happens
    run_specific_threshold_release 25 27

    # not released
    check_copy to_release copy_to_release copy_synced
    check_copy deprec_to_release copy_to_release copy_synced
    check_copy last_to_release copy_to_release copy_synced

    # with a specific higher threshold of 25% and a specific lower threshold
    # of 15%, the threshold is crossed at the last old candidate, but the
    # space to release to get back under the specific lower threshold is
    # greater than the about 30% of the dir occupied by the 3 old
    # candidates: the purge releases all of them in a best effort
    run_specific_threshold_release 25 15 \
        to_release deprec_to_release last_to_release

    # not released
    check_copy not_synced copy_to_release
    check_copy other_host copy_to_release copy_synced
    check_copy other_copy other copy_synced
    check_copy too_young copy_to_release copy_synced

    return 0
}

function check_hsm_release_dir_specific_threshold_unselectable()
{
    setup_hsm_release_objects

    # The extents of the source copy that are not selectable for release
    # count in the specific fill rate: the source copy occupies about 50%
    # of the dir (3 old enough candidates, not_synced without a backend
    # copy and too_young), and with a specific higher threshold of 35% and
    # a specific lower threshold of 15%, the threshold is crossed by the
    # unselectable extent of not_synced: the purge releases all the 3 old
    # candidates and keeps the unselectable ones.
    run_specific_threshold_release 35 15 \
        to_release deprec_to_release last_to_release

    # not released
    check_copy not_synced copy_to_release
    check_copy other_host copy_to_release copy_synced
    check_copy other_copy other copy_synced
    check_copy too_young copy_to_release copy_synced
}

function check_hsm_release_dir_specific_threshold_lower_zero()
{
    setup_hsm_release_objects

    # With a specific higher threshold of 10%, crossed at the first extent
    # of the source copy, and a specific lower threshold of 0%, the space
    # to release is the whole space occupied by the extents of the source
    # copy: every selectable copy is released, in a best effort as the
    # unselectable extents of not_synced and too_young can not be released.
    run_specific_threshold_release 10 0 \
        to_release deprec_to_release last_to_release

    # not released
    check_copy not_synced copy_to_release
    check_copy other_host copy_to_release copy_synced
    check_copy other_copy other copy_synced
    check_copy too_young copy_to_release copy_synced
}

function check_hsm_release_dir_general_threshold_precedence()
{
    setup_hsm_release_objects

    # When the fill rate of the dir, about 60%, exceeds the general higher
    # threshold, the general purge takes precedence over the specific one,
    # even when the specific thresholds are armed and crossed: with a
    # general lower threshold of 45%, the general purge stops after 2
    # releases, whereas the specific purge would release the 3 old
    # candidates to get the space occupied by the extents of the source
    # copy under the specific lower threshold of 15%.
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_higher_threshold="50"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_lower_threshold="45"
    run_specific_threshold_release 25 15 to_release deprec_to_release

    # not released
    check_copy last_to_release copy_to_release copy_synced
    check_copy not_synced copy_to_release
    check_copy other_host copy_to_release copy_synced
    check_copy other_copy other copy_synced
    check_copy too_young copy_to_release copy_synced
}

function check_hsm_release_dir_specific_threshold_invalid()
{
    # a malformed specific higher threshold fails the command and the
    # faulty value is named in the error
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_higher_threshold="7O"
    invalid_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced 2>&1 || true)
    (echo "${invalid_log}" | grep "'7O'") ||
        error "The malformed specific higher threshold '7O' must fail the " \
              "command and be named in the error"

    # a malformed specific lower threshold fails the command too, even when
    # the specific higher threshold does not arm the specific mode, as both
    # specific thresholds are always parsed
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_higher_threshold="100"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_lower_threshold="l5"
    invalid_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced 2>&1 || true)
    (echo "${invalid_log}" | grep "'l5'") ||
        error "The malformed specific lower threshold 'l5' must fail the " \
              "command and be named in the error"

    # a malformed general lower threshold fails the command too, as every
    # threshold is parsed the same way
    unset PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_higher_threshold
    unset PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_lower_threshold
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_lower_threshold="9O"
    invalid_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced 2>&1 || true)
    (echo "${invalid_log}" | grep "'9O'") ||
        error "The malformed general lower threshold '9O' must fail the " \
              "command and be named in the error"

    # an out-of-range specific higher threshold fails the command with a
    # non-zero exit code and the faulty value is named in the error
    unset PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_lower_threshold
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_higher_threshold="101"
    invalid_rc=0
    invalid_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced 2>&1) || invalid_rc=$?
    ((invalid_rc != 0)) ||
        error "The out-of-range specific higher threshold '101' must fail " \
              "the command"
    (echo "${invalid_log}" | grep "'101'") ||
        error "The out-of-range specific higher threshold '101' must be " \
              "named in the error"

    # an out-of-range specific lower threshold fails the command too
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_higher_threshold="25"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_specific_lower_threshold="100"
    invalid_log=$($valg_phobos_hsm_release_dir copy_to_release copy_synced 2>&1 || true)
    (echo "${invalid_log}" | grep "'100'") ||
        error "The out-of-range specific lower threshold '100' must fail " \
              "the command and be named in the error"

    return 0
}

function log_on_error()
{
    # object to release
    $phobos put --tags to_release --copy-name copy_to_release ${FILES[0]} to_release

    # get extent to release
    local extent_addr=$($phobos extent list -o address to_release | tr -d \ \'[])
    local extent_dir=$($phobos extent list -o media_name to_release | tr -d \ \'[])

    # sync the object
    $phobos copy create --tags for_sync to_release copy_synced

    # remove extent to release
    rm -f ${extent_dir}/${extent_addr}

    # run release and check that the log error file is created
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_release_delay_second="0"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_higher_threshold="1"
    export PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_dir_release_lower_threshold="0"
    $valg_phobos_hsm_release_dir -d source sync || true
    if [! -f "${PHOBOS_HSM_COPY_TO_RELEASE_COPY_SYNCED_error_log_path}" ]; then
        error "error log file must be created on error"
    fi
}

TESTS=(
    "check_hsm_release_dir_opt;"
    "setup; check_hsm_release_dir; cleanup"
    "setup; check_hsm_release_dir_specific_threshold; cleanup"
    "setup; check_hsm_release_dir_specific_threshold_unselectable; cleanup"
    "setup; check_hsm_release_dir_specific_threshold_lower_zero; cleanup"
    "setup; check_hsm_release_dir_general_threshold_precedence; cleanup"
    "setup; check_hsm_release_dir_specific_threshold_invalid; cleanup"
    "setup; log_on_error; cleanup"
)
