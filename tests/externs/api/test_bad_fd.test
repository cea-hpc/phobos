# test that phobos_get/phobos_put report the failure of the posix
# reader/writer initialization instead of crashing on the destroyed
# data processor

test_bin_dir=$PWD
test_bin="$test_bin_dir/test_bad_fd"
test_dir=$(dirname $(readlink -e $0))
. $test_dir/test_env.sh
. $test_dir/setup_db.sh
. $test_dir/test_launch_daemon.sh
. $test_dir/utils_generation.sh

function setup()
{
    setup_tables

    export PHOBOS_LRS_families="dir"
    export PHOBOS_STORE_default_family="dir"

    invoke_lrs

    setup_test_dirs
    dirs=($(mktemp -d ${DIR_TEST_IN}/XXXXXX))

    $phobos dir add ${dirs[@]}
    $phobos dir format --unlock ${dirs[@]}
}

function cleanup()
{
    waive_lrs

    cleanup_test_dirs
    drop_tables
}

function test_bad_fd()
{
    $LOG_COMPILER $test_bin
}

TESTS=(
    "setup; test_bad_fd; cleanup"
)

