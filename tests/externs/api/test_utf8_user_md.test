#
# Context initializer for the UTF-8 handling tests of the store API: the
# user metadata is silently sanitized, the object IDs are rejected.
#

test_bin_dir=$PWD
test_bin="$test_bin_dir/test_utf8_user_md"
test_dir=$(dirname $(readlink -e $0))
. $test_dir/test_env.sh
. $test_dir/setup_db.sh
. $test_dir/test_launch_daemon.sh
. $test_dir/utils_generation.sh

set -xe

function setup_dir
{
    setup_tables

    export PHOBOS_LRS_families="dir"
    export PHOBOS_STORE_default_family="dir"

    invoke_lrs

    setup_test_dirs
    setup_dummy_files 1 1k 1

    dir1="$DIR_TEST_IN/dir1"
    mkdir ${dir1}
    $phobos dir add ${dir1}
    $phobos dir format --fs posix --unlock ${dir1}
}

function cleanup_dir
{
    waive_lrs

    cleanup_dummy_files
    cleanup_test_dirs

    drop_tables
}

function test_utf8_user_md
{
    $LOG_COMPILER $test_bin ${FILES[0]} obj_utf8 ||
        error "The UTF-8 handling of the user metadata and of the object" \
              " IDs is not the expected one"
}

TESTS=(
    "setup_dir; test_utf8_user_md; cleanup_dir"
)
